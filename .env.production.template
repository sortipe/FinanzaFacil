# Variables de entorno para FinanzaFacil - Producción
# Copiar este archivo a .env.production y reemplazar valores

# Configuración del Frontend (Vite)
VITE_API_URL=https://tu-backend.com/api
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Configuración del Backend (Node.js/Express)
NODE_ENV=production
PORT=5555
HOST=0.0.0.0

# Base de datos (MySQL)
DB_HOST=localhost
DB_USER=tu_usuario_db
DB_PASSWORD=tu_contraseña_db
DB_NAME=finanzafacil_db
DB_PORT=3306
DB_CHARSET=utf8mb4

# SUNAT Integration
SUNAT_USERNAME=tu_usuario_sol
SUNAT_PASSWORD=tu_contraseña_sol
SUNAT_CERT_PATH=/path/to/certificado.pfx
SUNAT_CERT_PASSWORD=tu_contraseña_certificado

# Email Configuration
EMAIL_SERVICE=your_email_service
EMAIL_USER=tu_email@ejemplo.com
EMAIL_PASS=tu_contraseña_email

# Otros Servicios
GEMINI_API_KEY=tu_gemini_api_key_here

# Seguridad
JWT_SECRET=tu_jwt_secret_key_aqui
CORS_ORIGIN=https://tu-frontend.com

# Logs
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Tareas de fondo
RETRY_ENABLED=true
RETRY_TICK_MS=60000

# Archivos
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
PDF_TEMPLATE_DIR=./templates
